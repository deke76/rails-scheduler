<div class="d-flex align-items-center">
  <%= button_to edit_address_path(address), 
      class: "btn me-0",
      form: { data: { turbo_frame: dom_id(address) } } do %>
    <%= inline_svg_tag 'edit.svg', class: 'v-100 h-100' %>
  <% end %>
  <%= button_to address_path(address), 
      method: :delete, 
      class: "btn",
      form: { data: { turbo_confirm: "Are you sure?" } } do %>
    <%= inline_svg_tag 'trash.svg', class: 'v-100 h-100' %>
  <% end %>
</div> 