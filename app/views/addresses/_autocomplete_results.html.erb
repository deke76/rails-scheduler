<%= turbo_frame_tag "address_autocomplete_results" do %>
  <div class="list-group mt-2" data-address-autocomplete-target="results">
    <% addresses.each do |address| %>
      <button type="button" 
              class="list-group-item list-group-item-action"
              data-action="click->address-autocomplete#selectAddress"
              data-address-value="<%= address.to_json %>"
              data-address-autocomplete-target="result">
        <div class="d-flex w-100 justify-content-between">
          <h6 class="mb-1"><%= address["display_name"] %></h6>
        </div>
        <small class="text-muted">
          <%= [
            address.dig("address", "house_number"),
            address.dig("address", "road"),
            address.dig("address", "city"),
            address.dig("address", "state"),
            address.dig("address", "country")
          ].compact.join(", ") %>
        </small>
      </button>
    <% end %>
  </div>
<% end %> 