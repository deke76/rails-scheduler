<div class="mt-4 mx-auto w-75" data-controller="address-autocomplete">
  <div class="bg-white py-4 px-4 shadow rounded">
    <%= bootstrap_form_with(model: address, class: "needs-validation", novalidate: true) do |form| %>
      <% if address.errors.any? %>
        <div class="alert alert-danger">
          <h4 class="alert-heading"><%= pluralize(address.errors.count, "error") %> prohibited this address from being saved:</h4>
          <ul>
            <% address.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group mb-3">
        <input id="autocomplete" placeholder="Enter your address" type="text" class="form-control" data-address-autocomplete-target="autocomplete" required />
        <div class="invalid-feedback">
          Please enter a valid address.
        </div>
        <%= turbo_frame_tag "address_autocomplete_results" do %>
          <div class="list-group mt-2" data-address-autocomplete-target="results">
          </div>
        <% end %>
      </div>

      <div class="form-group mb-3" data-address-autocomplete-target="mapPreview">
        <% if address.map_image.attached? %>
          <%= image_tag address.map_image, class: "img-fluid rounded" %>
        <% end %>
      </div>

      <%= form.hidden_field :street_number, id: "street_number", data: { address_autocomplete_target: "streetNumber" } %>
      <%= form.hidden_field :route, id: "route", data: { address_autocomplete_target: "route" } %>
      <%= form.hidden_field :locality, id: "locality", data: { address_autocomplete_target: "locality" } %>
      <%= form.hidden_field :administrative_area_level_1, id: "administrative_area_level_1", data: { address_autocomplete_target: "administrativeArea" } %>
      <%= form.hidden_field :country, id: "country", data: { address_autocomplete_target: "country" } %>
      <%= form.hidden_field :postal_code, id: "postal_code", data: { address_autocomplete_target: "postalCode" } %>
      <%= form.hidden_field :map_image_url, data: { address_autocomplete_target: "mapImageUrl" } %>

      <div class="d-flex justify-content-between">
        <%= form.submit "Save Address", class: "btn btn-primary" %>
        <%= link_to 'Back', addresses_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
