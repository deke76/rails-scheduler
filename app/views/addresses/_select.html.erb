<div class="position-relative" data-controller="address">
  <div class="dropdown">
    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-address-target="button">
      <span>Select an address</span>
    </button>
    <ul class="dropdown-menu" data-address-target="menu">
      <% addresses.each do |address| %>
        <li>
          <button class="dropdown-item" 
                  data-action="click->address#handleAddressSelect"
                  data-address-id="<%= address.id %>">
            <%= address.name %>
          </button>
        </li>
      <% end %>
      <li><hr class="dropdown-divider"></li>
      <li>
        <%= link_to "Add new address", new_address_path, 
                    class: "dropdown-item", 
                    data: { turbo_frame: "new_address" } %>
      </li>
    </ul>
    <%= hidden_field_tag "ice_time[address_id]", @ice_time&.address_id %>
  </div>
</div> 