<%= render 'shared/show', 
    record: @address,
    title: @address.name,
    index_path: addresses_path do %>
  <p class="text-muted mb-0">
    <% if @address.unit_number.present? %>
      <%= @address.unit_number %>, 
    <% end %>
    <%= [@address.street_number, @address.street].compact.join(' ') %> <%= @address.city %>
  </p>
  <p class="text-muted mb-0">
    <%= [@address.province, @address.postal_code].compact.join(' ') %>
  </p>
  <p class="text-muted mb-0"><%= @address.country %></p>
<% end %>
