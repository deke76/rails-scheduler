<p style="color: green"><%= notice %></p>

<%= turbo_frame_tag dom_id(@address) do %>
  <div class="mt-4 mx-auto">    
    <%= render 'shared/card' do %>
      <div class="d-flex align-items-center mb-3">
        <div>
          <h5 class="mb-1"><%= @address.name %></h5>
        </div>
      </div>
      <div>
        <p class="text-muted mb-0">
          <% if @address.unit_number.present? %>
            <%= @address.unit_number %>, 
          <% end %>
          <%= [@address.street_number, @address.street].compact.join(' ') %> <%= @address.city %>
        </p>
        <p class="text-muted mb-0">
          <%= [@address.province, @address.postal_code].compact.join(' ') %>
        </p>
        <p class="text-muted mb-0"><%= @address.country_name %></p>
      </div>

      <div class="d-flex justify-content-between mt-3">
        <%= link_to addresses_path, class: "btn" do %>
          <%= inline_svg_tag 'arrow-left.svg', class: 'v-100 h-100' %>
        <% end %>
        <%= render 'addresses/actions', address: @address %>
      </div>
    <% end %>
  </div>
<% end %>
