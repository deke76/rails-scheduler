<%= bootstrap_form_with(model: @ice_time, data: { 
  turbo: true,
  controller: "form-actions",
  action: "turbo:submit-start->form#handleSubmit"
}) do |form| %>
  <%= render 'shared/form_errors', record: @ice_time %>
    
  <div data-controller="ice-time-selector">
    <div class="form-group mb-3">
      <div class="d-flex border rounded bg-white">
        <% IceTime::VALID_DAYS.each do |day| %>
          <div class="flex-fill text-center border-end py-2 cursor-pointer" 
            data-ice-time-selector-target="day"
            data-day="<%= day %>"
            data-action="click->ice-time-selector#select">
            <%= day == 'thursday' ? 'R' : day.first.upcase %>
            <%= check_box_tag "ice_time[day]", day, false, class: "d-none" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="form-group d-flex flex-column gap-0" id="<%= form.object_name %>-input">
      <label class="form-label mb-0">Start Time</label>
      <div class="d-flex justify-content-start align-content-center gap-1"> 
        <div class="w-25" id="<%= form.object_name %>-input-<%=:hour%>">
          <%= form.number_field :hour, 
            hide_label: true,
            placeholder: 'hour',
            min: 0, 
            step: 1 %>
        </div>
        <span class="py-1">:</span>

        <div class="w-25" id="<%= form.object_name %>-input-<%=:minute%>">
          <%= form.number_field :minute, 
            hide_label: true,
            placeholder: 'min',
            min: 0, 
            step: 15 %>
        </div>

        <div class="d-flex w-50 h-100" id="<%= form.object_name %>-input-<%=:am_pm%>">
            <% ['AM', 'PM'].each do |time| %>
              <div class="flex-fill text-center cursor-pointer form-control
                <%= time == 'AM' ? 'rounded-end-0 border-end-0' : 'rounded-start-0' %>"
                data-ice-time-selector-target="time"
                data-time="<%= time %>"
                data-action="click->ice-time-selector#selectTime">
                <%= time %>
                <%= radio_button_tag "ice_time[am_pm]", time, time =='PM', class: "d-none" %>
              </div>
            <% end %>
        </div>
      </div>
    </div>
    
    <div class="d-flex gap-0">
      <div class="form-group w-25 me-1" id="<%= form.object_name %>-input-<%=:length%>">
        <%= form.number_field :length,
          class: "form-control",
          hide_label: true,
          placeholder: 'min',
          min: 0,
          step: 15 %>
      </div>
      <span>&nbsp;</span>
      <div class="form-group w-75">
        <div id="ice_time_team_id">
          <%= render "teams/select", teams: @teams %>
        </div>
      </div>
    </div>
    <%= turbo_frame_tag "new_team" %>

    <div class="form-group" data-controller="address">
      <div id="ice_time_address_id">
        <%= render "addresses/select", addresses: @addresses %>
      </div>
    </div>

    <%= turbo_frame_tag "new_address" %>

  </div>

  <%= render 'shared/form_actions', 
      record: @ice_time,
      index_path: ice_times_path,
      delete_path: ice_time_path(@ice_time) %>

<% end %>
