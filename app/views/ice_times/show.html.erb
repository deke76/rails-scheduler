<%= render 'shared/show', 
    record: @ice_time,
    title: "#{@ice_time.team.name} Ice Time",
    index_path: ice_times_path do %>
  <% if @ice_time.opponent_id.present? %>
    <p class="text-muted mb-1">vs <%= @ice_time.opponent_id.name %></p>
  <% end %>
  <p class="text-muted mb-1">
    <%= @ice_time.day.titleize %> at <%= @ice_time.start_time.strftime("%I:%M %p") %>
  </p>
  <p class="text-muted mb-0">
    Length: <%= @ice_time.length %> minutes
  </p>
<% end %>
