<div class="d-flex align-items-center w-full">
  <%= link_to teams_path do %>
    <%= inline_svg_tag 'users.svg', 
      class: 'v-100 h-100' %>
  <% end %>
</div>

<div class="d-flex align-items-center w-full">
  <%= link_to addresses_path do %>
    <%= inline_svg_tag 'address.svg', 
      class: 'v-100 h-100' %>
  <% end %>
</div>

<div 
  data-controller="navigation" 
  class="d-flex align-items-center w-full pe-2"
  id="optionsNavigationSettings"
  data-action="navigation#click click@window->dropdown#hide">
  <%= inline_svg_tag 'user.svg', 
    class: 'v-100 h-100' %>
</div>
