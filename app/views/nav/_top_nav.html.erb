<nav class="navbar bg-light h-6em">
  <div class="d-flex align-items-center justify-content-between h-100 vw-100">
    <div class="navbar-brand ps-2">
      <%= link_to root_path do %>
        <%= inline_svg_tag 'scheduler-icon.svg', class: 'v-100 h-100' %>
      <% end %>
    </div>

    <div class="d-flex flex-content-between gap-5">
      <% if user_signed_in? %>
        <%= render "nav/authenticated" %>
      <% else %>
        <%= render "nav/unauthenticated" %>
      <% end %>
    </div>
  </div>
</nav>