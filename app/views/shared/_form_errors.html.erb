<% if record.errors.any? %>
  <div class="alert alert-danger">
    <h4 class="alert-heading">
      <%= pluralize(record.errors.count, "error") %> prohibited this <%= record.class.model_name.human.downcase %> from being saved:
    </h4>
    <ul>
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %> 