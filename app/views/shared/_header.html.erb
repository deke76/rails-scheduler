<div class="d-flex justify-content-center align-items-bottom mb-4 mr-2">
  <h1 class="mb-0 me-1"><%= controller.controller_name.singularize.titleize.pluralize %></h1>
  <small>
    <%= link_to send("new_#{controller.controller_name.singularize}_path"), 
      class: "text-muted",
      data: { turbo_frame: "new_ice_time" } do %>
      <%= inline_svg_tag 'plus.svg', class: 'v-100 h-100' %>
    <% end %>
  </small>
</div>