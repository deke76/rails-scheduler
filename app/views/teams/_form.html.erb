<%= form_with(model: team) do |form| %>
  <% if team.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(team.errors.count, "error") %> prohibited this team from being saved:</h2>

      <ul>
        <% team.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-4 mx-auto w-75">
    <div class="bg-white py-4 px-4 shadow rounded">
      <%= bootstrap_form_for(@team) do |form| %>
        <div class="form-group">
          <div class="d-flex justify-content-between align-items-center form-label px-1">
            <%= form.label :name, "Name" %>
            <button 
              class="btn btn-light border border-secondary" 
              id="toggle_file_upload_field
              type="button" 
              data-bs-toggle="collapse" 
              data-bs-target="#fileChooser" 
              aria-expanded="false" 
              aria-controls="fileChooser">
              <%= inline_svg_tag 'image-alt.svg', 
                alt: 'Logo',
                class: 'v-100 h-100' %>
            </button>
          </div>
          <%= form.text_field :name, hide_label: true %>
        </div>
        <div class="collapse" id="fileChooser">
          <%= form.file_field :logo %>
        </div>

        <div class="d-flex justify-content-between">
          <%= form.submit %>
          <%= link_to 'Back', teams_path %>
        </div>    
      <% end %>
    </div>
  </div>
</div>
<% end %>
