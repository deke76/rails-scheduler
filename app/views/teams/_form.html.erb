<%= bootstrap_form_with(model: team, data: { turbo: true, controller: "form-actions" }, multipart: true) do |form| %>
  <%= render 'shared/form_errors', record: team %>

  <div class="form-group">
    <div class="d-flex justify-content-start align-items-baseline form-label">
      <button 
        class="btn text-muted" 
        id="toggle_file_upload_field"
        type="button" 
        data-bs-toggle="collapse" 
        data-bs-target="#fileChooser" 
        aria-expanded="false" 
        aria-controls="fileChooser">
        <%= inline_svg_tag 'image-alt.svg', 
          alt: 'Logo',
          class: 'v-100 h-100' %>
      </button>
      <%= form.label :name, "Name" %>
    </div>
  </div>
  <%= form.text_field :name, hide_label: true %>
  <div class="collapse" id="fileChooser">
    <%= form.file_field :logo %>
  </div>

  <%= render 'shared/form_actions', 
      record: team,
      index_path: teams_path,
      delete_path: team_path(team) %>
<% end %>
