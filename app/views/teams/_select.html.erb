<div class="position-relative" data-controller="team">
  <div class="dropdown">
    <button class="form-control dropdown-toggle d-flex justify-content-between align-items-center" 
            type="button" 
            data-bs-toggle="dropdown" 
            aria-expanded="false"
            data-team-target="button">
      <span class="text-truncate"><%= @ice_time&.team&.name || "Select a team..." %></span>
    </button>
    <ul class="dropdown-menu w-100" data-team-target="menu">
      <li>
        <%= link_to "Add new team...", "#", 
            class: "dropdown-item", 
            data: { action: "click->team#handleNewTeam", turbo: false } %>
      </li>
      <li><hr class="dropdown-divider"></li>
      <% teams.each do |team| %>
        <li>
          <%= link_to team.name, "#", 
              class: "dropdown-item #{'active' if @ice_time&.team_id == team.id}",
              data: { 
                action: "click->team#handleTeamSelect",
                team_id: team.id,
                turbo: false
              } %>
        </li>
      <% end %>
    </ul>
  </div>
  <%= hidden_field_tag "ice_time[team_id]", @ice_time&.team_id %>
</div> 