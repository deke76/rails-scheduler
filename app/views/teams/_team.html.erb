<div id="<%= dom_id team %>" class="card mb-2">

  <div class="card-body">
  <%= image_tag url_for(team.logo) if team.logo.attached? %>
    <h5 class="card-title"><%= team.logo.attached? %></h5>
    <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
  </div>
</div>