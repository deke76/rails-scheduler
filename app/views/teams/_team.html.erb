<div id="<%= dom_id(team) %>" class="card mb-3">
  <div class="card-body d-flex flex-column justify-content-between align-items-center">
    <div class="d-flex align-items-center">
      
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
          <%= image_tag team_logo(team), class: "rounded me-3 w-25" %>
          <h5 class="card-title mb-0"><%= team.name %></h5>
        </div>
        <div class="d-flex align-items-center">
          <%= button_to edit_team_path(team), 
            class: "btn me-0" do %>
          <%= inline_svg_tag 'edit.svg', class: 'v-100 h-100' %>
          <% end %>
          <%= button_to team_path(team), 
            method: :delete, 
            class: "btn",
            form: { data: { turbo_confirm: "Are you sure?" } } do %>
            <%= inline_svg_tag 'trash.svg', class: 'v-100 h-100' %>
          <% end%>
        </div>
      </div>
    </div>
        <small class="text-muted"><%= strip_tags(BetterLorem.p(1, false)) %></small>
    
    <div class="d-flex flex-column justify-content-around btn-group">
      
      
    </div>
  </div>
</div>