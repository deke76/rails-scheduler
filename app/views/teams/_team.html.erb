<div id="<%= dom_id(team) %>" class="card mb-3">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
      <%= image_tag team_logo(team), class: "rounded me-3 w-25" %>
      
      <div>
        <h5 class="card-title mb-0"><%= team.name %></h5>
        <small class="text-muted"><%= strip_tags(BetterLorem.p(1, false)) %></small>
      </div>
    </div>
    
    <div class="d-flex flex-column justify-content-around btn-group gap-1">
      <%= button_to "Edit", edit_team_path(team), class: "btn btn-sm btn-outline-primary" %>
      <%= button_to "Delete", team_path(team), 
          method: :delete, 
          class: "btn btn-sm btn-outline-danger",
          form: { data: { turbo_confirm: "Are you sure?" } } %>
    </div>
  </div>
</div>
</div>