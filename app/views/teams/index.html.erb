<div class="d-flex justify-content-between align-items-top mb-4 mr-2">
  <h1 class="mb-0">Teams</h1>
  <%= link_to new_team_path, 
      class: "btn btn-light border border-secondary",
      data: { turbo_frame: "new_team" } do %>
    <%= inline_svg_tag 'plus.svg', class: 'v-100 h-100' %>
  <% end %>
</div>

<%= turbo_frame_tag "new_team" %>
<%= turbo_frame_tag "teams" do %>
  <% @teams.each do |team| %>
    <%= turbo_frame_tag dom_id(team) do %>
      <%= link_to team, class: "text-decoration-none" do %>
        <%= render team %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
