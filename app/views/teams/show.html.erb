<%= turbo_frame_tag dom_id(@team) do %>
  <div class="mt-4 mx-auto w-75">
    <div class="bg-white py-4 px-4 shadow rounded">
      <div class="d-flex align-items-center mb-4">
        <%= image_tag team_logo(@team), class: "rounded w-25" %>
        <div>
          <h5 class="mb-1">Team Details</h5>
          <p class="text-muted mb-0">Record: 10 - 12 - 3</p>
          <p class="text-muted mb-0">Arena: Village Square</p>
          <p class="text-muted mb-0">Ice Time: 10:00pm Monday</p>
          <p class="text-muted mb-0">Notes: <%= strip_tags(BetterLorem.p(2, false)) %></p>
        </div>
      </div>

      <div class="d-flex justify-content-between">
        <%= link_to teams_path,  class: "btn" do %>
          <%= inline_svg_tag 'arrow-left.svg', class: 'v-100 h-100' %>
        <% end %>
        <%= button_to team_path(@team), 
            method: :delete, 
            class: "btn",
            form: { data: { turbo_confirm: "Are you sure?" } } do %>
          <%= inline_svg_tag 'trash.svg', class: 'v-100 h-100' %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
