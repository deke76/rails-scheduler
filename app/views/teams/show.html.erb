<%= render 'shared/show', 
    record: @team,
    title: @team.name,
    index_path: teams_path,
    image: image_tag(team_logo(@team), class: "rounded w-25 mb-2 team-logo") do %>
  <p class="text-muted mb-0">Record: 10 - 12 - 3</p>
  <p class="text-muted mb-0">Arena: Village Square</p>
  <p class="text-muted mb-0">Ice Time: 10:00pm Monday</p>
  <p class="text-muted mb-0">Notes: <%= strip_tags(BetterLorem.p(1, false)) %></p>
<% end %>
