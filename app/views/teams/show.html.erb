<%= turbo_frame_tag dom_id(@team) do %>
  <div class="mt-4 mx-auto w-75">
    <div class="bg-white py-4 px-4 shadow rounded">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><%= @team.name %></h2>
        <div class="btn-group">
          <%= link_to edit_team_path(@team), 
              class: "btn btn-light border border-secondary",
              data: { turbo_frame: dom_id(@team) } do %>
            <%= inline_svg_tag 'pencil.svg', class: 'v-100 h-100' %>
          <% end %>
          <%= link_to teams_path, 
              class: "btn btn-light border border-secondary",
              data: { turbo_frame: "_top" } do %>
            <%= inline_svg_tag 'x.svg', class: 'v-100 h-100' %>
          <% end %>
        </div>
      </div>

      <div class="d-flex align-items-center mb-4">
        <%= image_tag team_logo(@team), class: "rounded me-3", style: "width: 100px; height: 100px; object-fit: cover;" %>
        <div>
          <h5 class="mb-1">Team Details</h5>
          <p class="text-muted mb-0"><%= strip_tags(BetterLorem.c(20, false)) %></p>
        </div>
      </div>

      <div class="d-flex justify-content-between">
        <%= link_to "Back to teams", teams_path, class: "btn btn-secondary" %>
        <%= button_to "Delete team", team_path(@team), 
            method: :delete, 
            class: "btn btn-danger",
            form: { data: { turbo_confirm: "Are you sure?" } } %>
      </div>
    </div>
  </div>
<% end %>
