<%= turbo_frame_tag dom_id(@team) do %>
    <%= render 'shared/card' do %>
      <div class="d-flex flex-row align-items-center">
        <%= image_tag team_logo(@team), class: "rounded w-25 mb-2" %>
        <h5 class="card-title text-center"><%= @team.name %></h5>
      </div>
      <div>
        <p class="text-muted mb-0">Record: 10 - 12 - 3</p>
        <p class="text-muted mb-0">Arena: Village Square</p>
        <p class="text-muted mb-0">Ice Time: 10:00pm Monday</p>
        <p class="text-muted mb-0">Notes: <%= strip_tags(BetterLorem.p(1, false)) %></p>
      </div>

      <div class="d-flex justify-content-between mt-3">
        <%= link_to teams_path, class: "btn" do %>
          <%= inline_svg_tag 'arrow-left.svg', class: 'v-100 h-100' %>
        <% end %>
        <%= render 'teams/actions', team: @team %>
      </div>
    <% end %>
<% end %>
